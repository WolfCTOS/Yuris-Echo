<Window x:Class="LuaApiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LuaApiLauncher"
        Title="Yuri's Echo"
        Width="1280" Height="720"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        FontFamily="Bahnschrift, Segoe UI"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Dark checkbox: 18x18 box, #343A47 stroke, #E6E8EC check -->
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" Background="#0B0F14" BorderBrush="#343A47"
                                    BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="Mark" Data="M 3,8 L 6,11 L 13,3" Stroke="#E6E8EC" StrokeThickness="2"
                                      Visibility="Collapsed" SnapsToDevicePixels="True"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E6E8EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark tabs: flat header strip, active tab filled -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#7C8290"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot" Background="Transparent" BorderBrush="#343A47"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#1E232D"/>
                                <Setter Property="Foreground" Value="#E6E8EC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#151922"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Grid.Row="0" Margin="0,0,0,10"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Row" Background="Transparent">
                            <Rectangle x:Name="SelBar" Width="3" HorizontalAlignment="Left" Fill="#E6E8EC" Visibility="Collapsed"/>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              Margin="10,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C8290"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E8EC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1E232D"/>
            <Setter Property="Foreground" Value="#C9CCD3"/>
            <Setter Property="BorderBrush" Value="#343A47"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#C9CCD3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#C9CCD3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1E232D" BorderBrush="#343A47" BorderThickness="1">
                                            <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="#E6E8EC" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="4,2,24,2"
                                     Background="#1E232D" Foreground="#C9CCD3" BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" Focusable="False">
                                <Border Background="#151922" BorderBrush="#343A47" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#CC1E232D"/>
            <Setter Property="Foreground" Value="#C9CCD3"/>
            <Setter Property="BorderBrush" Value="#343A47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#E6E8EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C9CCD3"/>
            <Setter Property="Background" Value="#10141B"/>
            <Setter Property="BorderBrush" Value="#343A47"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SegRoot" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegRoot" Property="Background" Value="#1A2029"/>
                                <Setter TargetName="SegRoot" Property="BorderBrush" Value="#E6E8EC"/>
                            </Trigger>
                            <!-- Selected: light fill with dark text (>= 12:1 contrast). -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegRoot" Property="Background" Value="#E6E8EC"/>
                                <Setter TargetName="SegRoot" Property="BorderBrush" Value="#E6E8EC"/>
                                <Setter Property="Foreground" Value="#0B0F14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#7C8290"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabRoot" Background="Transparent" BorderBrush="#343A47"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#E6E8EC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#1E232D"/>
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#E6E8EC"/>
                                <Setter Property="Foreground" Value="#E6E8EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="10"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24">
                            <Border Height="4" VerticalAlignment="Center" Background="#343A47"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" VerticalAlignment="Center" Background="#E6E8EC"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#E6E8EC" BorderBrush="#0B0F14" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox x:Name="RootViewbox" Stretch="Uniform" StretchDirection="DownOnly">
    <Grid x:Name="RootLayout" Width="1280" Height="720">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Background layer -->
        <Grid Grid.RowSpan="2" x:Name="BgLayer">
            <Rectangle x:Name="BgGradient"/>
            <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed"/>
            <Rectangle x:Name="BgOverlay"/>
            <Rectangle x:Name="BgNoise" Opacity="0.035" IsHitTestVisible="False"/>
            <Rectangle x:Name="BgVignette" IsHitTestVisible="False"/>
        </Grid>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#CC0B0F14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#343A47" Opacity="0.6"/>
            <TextBlock Text="YURI'S ECHO" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#7C8290" FontSize="11"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinBtn" Content="&#x2013;" Width="46" Height="32" Click="MinBtn_Click" Style="{x:Null}"
                        Background="Transparent" Foreground="#C9CCD3" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                <Button x:Name="CloseBtn" Content="&#x2715;" Width="46" Height="32" Click="CloseBtn_Click" Style="{x:Null}"
                        Background="Transparent" Foreground="#C9CCD3" BorderThickness="0" FontSize="12" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <!-- ======================= MAIN MENU ======================= -->
            <Grid x:Name="MainView">
                <Canvas>
                    <Rectangle Width="3" Height="96" Canvas.Left="45" Canvas.Top="44" Fill="#E6E8EC"/>
                    <TextBlock Canvas.Left="60" Canvas.Top="32" Text="YURI'S ECHO" FontSize="60" FontWeight="Bold"
                               Foreground="#C9CCD3"/>
                    <TextBlock Canvas.Left="62" Canvas.Top="126" Text="RED ALERT 2: YURI'S LEGACY"
                               FontSize="14" Foreground="#E6E8EC"/>
                    <Rectangle Canvas.Left="62" Canvas.Top="154" Width="260" Height="1" Fill="#E6E8EC"/>
                    <TextBlock Canvas.Left="62" Canvas.Top="176" Text="CAMPAIGN MOD / LUAAPI ENGINE" FontSize="11"
                               Foreground="#7C8290"/>
                </Canvas>

                <Border Width="372" Margin="0,40,40,40" HorizontalAlignment="Right"
                        Background="#CC11151D" BorderBrush="#343A47" BorderThickness="1">
                    <Grid Margin="14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="YURI'S ECHO" FontSize="11" Foreground="#7C8290"/>
                            <TextBlock Text="ГЛАВНОЕ МЕНЮ" FontSize="26" Foreground="#C9CCD3"/>
                            <Rectangle Width="96" Height="2" Fill="#E6E8EC" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <local:MenuActionButton x:Name="BtnSkirmish" Text="Скирмиш" Margin="0,0,0,4" Click="BtnSkirmish_Click"/>
                            <local:MenuActionButton x:Name="BtnCncNet" Text="CnCNet" Margin="0,0,0,4" Click="BtnCncNet_Click"/>
                            <local:MenuActionButton x:Name="BtnCampaign" Text="Кампания" Margin="0,0,0,4" Click="BtnCampaign_Click"/>
                            <local:MenuActionButton x:Name="BtnOptions" Text="Опции" Margin="0,0,0,4" Click="BtnOptions_Click"/>
                            <local:MenuActionButton x:Name="BtnStats" Text="Статистика" Margin="0,0,0,4" Click="BtnStats_Click"/>
                            <local:MenuActionButton x:Name="BtnMapEditor" Text="Редактор карт" Margin="0,0,0,4" Click="BtnMapEditor_Click"/>
                            <local:MenuActionButton x:Name="BtnModsManager" Text="Менеджер модов" Margin="0,4,0,0" Click="BtnModsManager_Click"/>
                            <local:MenuActionButton x:Name="BtnExit" Text="Выход" Margin="0,4,0,0" Click="BtnExit_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <Rectangle Height="1" Fill="#343A47" Margin="0,0,0,8" Opacity="0.7"/>
                            <Grid>
                                <TextBlock Text="CnCNet online" FontSize="12" Foreground="#7C8290"/>
                                <TextBlock x:Name="OnlineStatus" Text="N/A" FontSize="12" Foreground="#C9CCD3"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="StatusLine" FontSize="11" Foreground="#7C8290" TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================= CAMPAIGN ======================= -->
            <Grid x:Name="CompanyView" Visibility="Collapsed" Margin="40,20,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="46" Fill="#E6E8EC" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="КАМПАНИЯ" FontSize="11" Foreground="#E6E8EC"/>
                        <TextBlock Text="ВЫБОР МИССИИ" FontSize="26" Foreground="#C9CCD3"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,16,0,16">
                    <Grid.ColumnDefinitions>
                        <!-- List hugs its content; details get the freed width. -->
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Missions -->
                    <Border Grid.Column="0" Background="#CC11151D" BorderBrush="#343A47" BorderThickness="1">
                        <Grid Margin="14,12,10,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="МИССИИ" FontSize="11" Foreground="#7C8290" Margin="4,0,0,6"/>
                            <StackPanel x:Name="CampaignSideTabs" Grid.Row="1" Orientation="Horizontal"
                                        Margin="4,0,0,10"/>

                            <ListBox x:Name="MissionList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                     Foreground="#C9CCD3"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="MissionList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <!-- Campaign headers are captions, not selectable rows. -->
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Resources>
                                    <DataTemplate DataType="{x:Type local:CampaignHeader}">
                                        <StackPanel Margin="8,12,8,5" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Title}" Foreground="#7C8290" FontSize="10"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Rectangle Height="1" Fill="#343A47" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type local:CampaignMission}">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#C9CCD3" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,12,0"/>
                                    </DataTemplate>
                                </ListBox.Resources>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Details - content-sized so the panel ends after the description. -->
                    <Border x:Name="MissionDetailsBorder" Grid.Column="2" Background="#CC11151D"
                            BorderBrush="#343A47" BorderThickness="1" VerticalAlignment="Top"
                            Visibility="Collapsed">
                        <StackPanel Margin="16,12,16,14">
                            <TextBlock Text="ОПИСАНИЕ МИССИИ" FontSize="11" Foreground="#7C8290" Margin="4,0,0,8"/>

                            <StackPanel Margin="4,0,4,0">
                                <TextBlock x:Name="MissionTitle" FontSize="18" Foreground="#E6E8EC" TextWrapping="Wrap"/>
                                <TextBlock x:Name="MissionMeta" FontSize="11" Foreground="#7C8290" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>

                                <Rectangle x:Name="MissionDivider" Height="1" Fill="#343A47" Margin="0,12,0,12"/>

                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="MissionDesc" FontSize="12" Foreground="#C9CCD3" TextWrapping="Wrap"
                                               LineHeight="18"/>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="ЗАПУСТИТЬ МИССИЮ" Grid.Column="0" Width="200" Height="40"
                        Style="{StaticResource SmallButton}" Click="BtnStartCampaign_Click" Foreground="#E6E8EC"/>
                    <TextBlock Grid.Column="1" x:Name="CompanyStatus" FontSize="12" Foreground="#7C8290"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="16,0"/>
                    <Button Grid.Column="2" Content="НАЗАД" Width="120" Style="{StaticResource SmallButton}"
                            Click="BtnCompanyBack_Click"/>
                </Grid>
            </Grid>

            <!-- ======================= SKIRMISH ======================= -->
            <Grid x:Name="SkirmishView" Visibility="Collapsed" Margin="28,18,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="46" Fill="#E6E8EC" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="НАСТРОЙКА БОЯ" FontSize="11" Foreground="#E6E8EC"/>
                        <TextBlock Text="СКИРМИШ" FontSize="26" Foreground="#C9CCD3"/>
