            <Button Name="TabGameBtn" Content="ИГРА" Width="104" Height="28" FontSize="11" Margin="0,0,6,0" Style="{StaticResource SmallButton}" FocusVisualStyle="{x:Null}" Click="TabGame_Click" />
            <Button Name="TabStorageBtn" Content="ХРАНИЛИЩЕ" Width="104" Height="28" FontSize="11" Margin="0,0,6,0" Style="{StaticResource SmallButton}" FocusVisualStyle="{x:Null}" Click="TabStorage_Click" />
