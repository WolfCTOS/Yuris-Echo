            <Grid MaxWidth="1100" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#161B24" BorderBrush="#343A47" BorderThickness="1" Padding="14">
            <StackPanel>
            <TextBlock Text="ЗАНЯТО НА ДИСКЕ" FontSize="11" Foreground="#B8BDC8" Margin="0,0,0,10" />
            <TextBlock Name="TxtStorage" FontSize="12" Foreground="#C9CCD3" TextWrapping="Wrap" />
            </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#161B24" BorderBrush="#343A47" BorderThickness="1" Padding="14">
            <StackPanel>
            <TextBlock Text="ДИСК" FontSize="11" Foreground="#B8BDC8" Margin="0,0,0,10" />
            <TextBlock Name="TxtStorageDisk" FontSize="12" Foreground="#C9CCD3" TextWrapping="Wrap" />
            <Button Content="ОТКРЫТЬ ПАПКУ ИГРЫ" Height="38" Margin="0,14,0,0" Style="{StaticResource SmallButton}" Click="BtnOpenRoot_Click" />
            <TextBlock Text="Кнопка только открывает папку в Проводнике; она ничего не удаляет." FontSize="11" Foreground="#7A8190" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
            </Border>
            </Grid>
            </Grid>

            <Grid Name="TabUpdates" Visibility="Collapsed">
            <Grid MaxWidth="1100" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#161B24" BorderBrush="#343A47" BorderThickness="1" Padding="14">
            <StackPanel>
            <TextBlock Text="КАНАЛ ОБНОВЛЕНИЙ" FontSize="11" Foreground="#B8BDC8" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Канал" Foreground="#B8BDC8" FontSize="12" VerticalAlignment="Center" />
            <ComboBox Name="CmbUpdateChannel" Grid.Column="1" Width="260" HorizontalAlignment="Left" /></Grid>
            <TextBlock Name="TxtChannelNow" FontSize="11" Foreground="#7A8190" TextWrapping="Wrap" />
            </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#161B24" BorderBrush="#343A47" BorderThickness="1" Padding="14">
            <StackPanel>
            <TextBlock Text="ОБНОВЛЕНИЕ КЛИЕНТА" FontSize="11" Foreground="#B8BDC8" Margin="0,0,0,10" />
            <TextBlock FontSize="11" Foreground="#7A8190" TextWrapping="Wrap" Text="Каналы Pre-release и Dev нужны для тестирования новых версий: возможны неожиданные ошибки. О проблемах сообщайте в Discord, указывая выбранный канал." />
            <Button Content="ПОДДЕРЖКА (DISCORD)" Height="38" Margin="0,14,0,0" Style="{StaticResource SmallButton}" Click="BtnSupport_Click" />
            <TextBlock Text="Файлы обновляет updater CnCNet-клиента; лаунчер только переключает канал." FontSize="11" Foreground="#7A8190" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
            </Border>
            </Grid>
            </Grid>

            <Grid Name="TabComponents" Visibility="Collapsed">
            <Grid MaxWidth="1100" HorizontalAlignment="Center">
            <Border Background="#161B24" BorderBrush="#343A47" BorderThickness="1" Padding="14">
            <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="КОМПОНЕНТЫ КЛИЕНТА" FontSize="11" Foreground="#B8BDC8" Margin="0,0,0,10" />
            <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="11" Foreground="#7A8190" TextWrapping="Wrap" Text="Отсутствующие компоненты скачивает updater CnCNet-клиента; лаунчер их не загружает и не удаляет." />
            <ListBox Name="ComponentsList" Background="#00FFFFFF" BorderThickness="0" Foreground="#C9CCD3" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
            </Border>
            </Grid>
            </Grid>
            </Grid>
            </ScrollViewer>
            </Border>
            <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Name="BtnCfgReset" Content="Сбросить по умолчанию" Height="32" Padding="12,0" Margin="0,0,12,0" Style="{StaticResource SmallButton}" Click="BtnCfgReset_Click" />
            <TextBlock Name="TxtUnsaved" Text="Есть несохранённые изменения" Foreground="#D6A84A" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnCfgSave" Content="СОХРАНИТЬ" Width="130" Height="32" Margin="0,0,8,0" Style="{StaticResource SmallButton}" Foreground="#E6E8EC" Click="BtnCfgSave_Click" />
            <Button Name="BtnCfgCancel" Content="ОТМЕНА" Width="130" Height="32" Style="{StaticResource SmallButton}" Click="BtnCfgBack_Click" />
            </StackPanel>
            </Grid>
            </Grid>
            <Grid Name="StatsView" Visibility="Collapsed" Margin="40,20,40,20">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
            <Rectangle Width="3" Height="46" Fill="#E6E8EC" Margin="0,0,10,0" />
            <StackPanel>
            <TextBlock Text="STATISTICS" FontSize="11" Foreground="#E6E8EC" />
            <TextBlock Text="СТАТИСТИКА" FontSize="26" Foreground="#C9CCD3" />
            </StackPanel>
            </StackPanel>
            <Border Grid.Row="1" Margin="0,14,0,14" Background="#CC11151D" BorderBrush="#343A47" BorderThickness="1">
            <ScrollViewer Margin="18" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="StatsText" FontFamily="Consolas, Bahnschrift, Segoe UI" FontSize="13" Foreground="#C9CCD3" />
            </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="НАЗАД" Width="120" Style="{StaticResource SmallButton}" Click="BtnStatsBack_Click" />
            </StackPanel>
            </Grid>

            <!-- ======================= NOTICE OVERLAY ======================= -->
            <Grid x:Name="NoticeOverlay" Visibility="Collapsed" Background="#E60B0F14">
                <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0F131B" BorderBrush="#343A47" BorderThickness="1" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="NoticeTitle" Text="Уведомление" FontSize="11" Foreground="#E6E8EC"/>
                        <TextBlock x:Name="NoticeBody" FontSize="18" Foreground="#C9CCD3" TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="BtnOpenLog" Content="ОТКРЫТЬ ЖУРНАЛ" Width="170" Height="38" Margin="0,0,8,0"
                                    Style="{StaticResource SmallButton}" Click="BtnOpenLog_Click" Visibility="Collapsed"/>
                            <Button Content="OK" Width="120" Height="38"
                                    Style="{StaticResource SmallButton}" Click="BtnNoticeOk_Click" Foreground="#E6E8EC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Viewbox>
</Window>
