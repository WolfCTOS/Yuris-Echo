                                    <TextBlock x:Name="MapPath" FontSize="10" Foreground="#7C8290"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="MapSize" FontSize="10" Foreground="#5B616E"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== RIGHT: tabs + back ==================== -->
                    <Border Grid.Column="4" Background="#CC11151D" BorderBrush="#343A47" BorderThickness="1">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TabControl Grid.Row="0" x:Name="SkirmishTabs" Background="Transparent" BorderThickness="0"
                                        Foreground="#C9CCD3" Margin="-4,-4,0,0"
