                                <TabItem Header="НАСТРОЙКИ" x:Name="TabSettings">
                                    <ScrollViewer Margin="12,6,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="SettingsPanel" Margin="0,0,4,4"/>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="МОДЫ" x:Name="TabMods">
                                    <Grid Margin="12,10,12,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- search + preset set + dev toggle -->
                                        <StackPanel Grid.Row="0">
                                            <Grid>
                                                <TextBox x:Name="ModSearchBox" Height="26" Padding="8,3,8,3"
                                                         FontSize="12" Foreground="#C9CCD3" Background="#0B0F14"
                                                         BorderBrush="#343A47" BorderThickness="1" CaretBrush="#E6E8EC"
                                                         TextChanged="ModSearchBox_TextChanged"/>
                                                <TextBlock x:Name="ModSearchHint" Text="ПОИСК МОДА..." FontSize="11"
                                                           Foreground="#5B616E" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Grid>
                                            <TextBlock Text="НАБОР МОДОВ" FontSize="10" Foreground="#7C8290" Margin="0,8,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="ModPresetCombo" Grid.Column="0" Height="26" FontSize="11"
                                                          SelectionChanged="ModPresetCombo_SelectionChanged"/>
                                                <Button x:Name="BtnSavePreset" Grid.Column="1" Content="СОХРАНИТЬ"
                                                        Margin="6,0,0,0" Height="26" Style="{StaticResource SmallButton}"
                                                        Click="BtnSavePreset_Click" Foreground="#E6E8EC"
                                                        ToolTip="Сохранить текущий выбор как набор «Мой набор»"/>
                                            </Grid>
                                            <CheckBox x:Name="ChkShowDevMods" Content="Показывать dev-моды"
                                                      Margin="0,8,0,0" Foreground="#C9CCD3" FontSize="11"
                                                      Checked="ChkShowDevMods_Changed" Unchecked="ChkShowDevMods_Changed"/>
                                        </StackPanel>

                                        <!-- full-height mod list -->
                                        <Border Grid.Row="1" Background="#0F131B" BorderBrush="#2A303C"
                                                BorderThickness="1" Margin="0,8,0,8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Padding="4,2">
                                                <StackPanel x:Name="SkirmishModsPanel"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- details of the selected mod -->
                                        <Border Grid.Row="2" Background="#0F131B" BorderBrush="#343A47"
                                                BorderThickness="1" Padding="10,8" MaxHeight="180">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock x:Name="ModDetailsName" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="#C9CCD3" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="ModDetailsMeta" FontSize="10" Foreground="#7C8290"
                                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock x:Name="ModDetailsDesc" FontSize="11" Foreground="#9AA0AC"
                                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock x:Name="ModDetailsWarn" FontSize="10" Foreground="#E6B85C"
                                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </TabItem>
                            </TabControl>

                            <Button Grid.Row="1" Content="НАЗАД" Height="40" Margin="0,10,0,0"
                                    Style="{StaticResource SmallButton}" Click="BtnSkirmishBack_Click"/>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock x:Name="SkirmishBuildMarker" Grid.Row="1" Text="" FontSize="9" Foreground="#5B616E"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2"
                           IsHitTestVisible="False" Panel.ZIndex="50"/>
            </Grid>

            <Grid Name="OptionsView" Visibility="Collapsed" Margin="40,20,40,20">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
