                                </Grid>
                                <StackPanel x:Name="PlayerTablePanel"/>
                            </DockPanel>
                        </Border>

                        <!-- Map preview fills the remaining space -->
                        <Border Grid.Row="2" Background="#CC11151D" BorderBrush="#343A47" BorderThickness="1">
