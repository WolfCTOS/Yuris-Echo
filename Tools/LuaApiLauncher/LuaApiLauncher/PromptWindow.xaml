<Window x:Class="LuaApiLauncher.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt" Width="380" Height="150"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F131B" FontFamily="Bahnschrift, Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" FontSize="12" Foreground="#C9CCD3" TextWrapping="Wrap"/>
        <TextBox x:Name="PromptInput" Grid.Row="1" Margin="0,10,0,12" Height="28"
                 FontSize="13" Foreground="#E6E8EC" Background="#0B0F14"
                 BorderBrush="#343A47" BorderThickness="1" CaretBrush="#E6E8EC"
                 Padding="8,4,8,4" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkBtn" Content="OK" Width="110" Height="30" Margin="0,0,8,0"
                    Background="#1E232D" Foreground="#E6E8EC" BorderBrush="#343A47" BorderThickness="1"
                    Cursor="Hand" Click="OkBtn_Click"/>
            <Button x:Name="CancelBtn" Content="ОТМЕНА" Width="110" Height="30"
                    Background="#1E232D" Foreground="#C9CCD3" BorderBrush="#343A47" BorderThickness="1"
                    Cursor="Hand" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
