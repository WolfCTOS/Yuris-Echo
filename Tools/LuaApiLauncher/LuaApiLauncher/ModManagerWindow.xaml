<Window x:Class="LuaApiLauncher.ModManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LuaApiLauncher"
        Title="Менеджер модов"
        Width="920" Height="600"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        FontFamily="Bahnschrift, Segoe UI"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" Background="#0B0F14" BorderBrush="#343A47"
                                    BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="Mark" Data="M 3,8 L 6,11 L 13,3" Stroke="#E6E8EC" StrokeThickness="2"
                                      Visibility="Collapsed" SnapsToDevicePixels="True"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E6E8EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#CC1E232D"/>
            <Setter Property="Foreground" Value="#C9CCD3"/>
            <Setter Property="BorderBrush" Value="#343A47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#E6E8EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Rectangle Width="3" Height="44" Fill="#E6E8EC" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="YURI'S ECHO" FontSize="11" Foreground="#E6E8EC"/>
                <TextBlock Text="МЕНЕДЖЕР МОДОВ" FontSize="22" Foreground="#C9CCD3"/>
            </StackPanel>
        </StackPanel>

        <!-- Statistics: MODS / ACTIVE / .lua / .json -->
        <TextBlock x:Name="ManagerStats" Grid.Row="0" FontSize="11" Foreground="#7C8290"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Load order -->
            <Border Grid.Column="0" Background="#11151D" BorderBrush="#343A47" BorderThickness="1">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="ПОРЯДОК ЗАГРУЗКИ" FontSize="11" Foreground="#7C8290"
                               Margin="4,0,0,8"/>
                    <ListBox x:Name="ModList" Background="#00FFFFFF" BorderThickness="0" Foreground="#C9CCD3"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ModList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- Details of the selected mod (no description - not duplicated) -->
            <Border Grid.Column="2" Background="#11151D" BorderBrush="#343A47" BorderThickness="1">
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ДЕТАЛИ" FontSize="11" Foreground="#7C8290" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DetName" FontSize="20" Foreground="#C9CCD3" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetMeta" FontSize="12" Foreground="#7C8290" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Border x:Name="DetWarnBox" Background="#22E6B85C" BorderBrush="#E6B85C" BorderThickness="1"
                                Padding="8" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="DetWarn" Foreground="#F0D49A" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="ФАЙЛЫ .LUA / .JSON" FontSize="11" Foreground="#7C8290" Margin="0,16,0,8"/>
                        <StackPanel x:Name="FilesPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="ВКЛЮЧИТЬ ВСЕ" Margin="0,0,8,0" Style="{StaticResource SmallButton}" Click="BtnEnableAll_Click"/>
                <Button Content="ВЫКЛЮЧИТЬ ВСЕ" Margin="0,0,8,0" Style="{StaticResource SmallButton}" Click="BtnDisableAll_Click"/>
                <Button Content="ОБНОВИТЬ" Style="{StaticResource SmallButton}" Click="BtnRefresh_Click"/>
                <Button Content="ОТКРЫТЬ ПАПКУ МОДОВ" Margin="12,0,0,0" Style="{StaticResource SmallButton}"
                        Click="BtnOpenFolder_Click" Foreground="#E6E8EC"/>
            </StackPanel>
            <Button Content="ЗАКРЫТЬ" Width="120" HorizontalAlignment="Right" Style="{StaticResource SmallButton}"
                    Foreground="#E6E8EC" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
